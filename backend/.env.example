PORT=5000
NODE_ENV=development

# CJ Dropshipping - API Key authentication (v2 apiKey mode)
CJ_API_KEY=
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# Neon PostgreSQL - our own product catalog (see database/schema.sql)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Stripe - test-mode secret key (starts with sk_test_...) in dev, live
# (sk_live_...) in production. Never commit a real key.
STRIPE_SECRET_KEY=

# Base URL of the running frontend, used for CORS and to build Stripe's
# success/cancel redirect URLs. REQUIRED in production - startup fails
# without it (see validateEnv.js) so CORS is never left defaulting to
# localhost or wide open. For multiple allowed origins (e.g. a preview URL
# alongside production), set the comma-separated CORS_ORIGINS instead/also.
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=https://example.com,https://preview.example.com

# JWT signing secret for customer/admin authentication. Required, minimum 32
# characters (64+ recommended in production). Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse a value across environments, never commit the real value.
JWT_SECRET=

# Resend - transactional email (order confirmation, payment success,
# shipping placeholder, admin new-order notification). Leave RESEND_API_KEY
# blank to run in dev-stub mode: emails are logged to the console instead of
# sent, so the flows are fully testable with no external setup. Get a real
# key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. onboarding@resend.dev works out of the box in Resend's
# sandbox once a real API key is set (no domain verification needed for
# testing) - swap for a verified domain address before production.
RESEND_FROM_EMAIL="Burney Boyz <onboarding@resend.dev>"
# Where new-order and admin-access-request notifications are sent. Must
# match the Resend account's own verified address while Resend is in
# sandbox/testing mode (no custom domain verified yet) - otherwise sends fail.
ADMIN_NOTIFICATION_EMAIL=
